CONFIG_IDF_TARGET="esp32c5"

# Bluetooth: NimBLE, observer + broadcaster only
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Wi-Fi + BLE share the radio
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Flash / partitions: Wi-Fi + BLE does not fit the default 1 MB app slot
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Restart instead of hanging if something goes badly wrong
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_PANIC=y

# Radio power: maximum on both BLE (+20 dBm) and Wi-Fi (20 dBm)
CONFIG_BT_LE_DFT_TX_POWER_LEVEL_P20=y
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
